[Unit]
Description=Brainkeep shared memory (MCP server)
After=network.target

[Service]
Type=simple
User=brainkeep
Group=brainkeep
UMask=0077
StateDirectory=brainkeep
StateDirectoryMode=0700
# BRAINKEEP_HOST: public host name served by the reverse proxy (e.g. memory.example.com).
# BRAINKEEP_ARGS: optional extra flags, e.g. "--oauth-file /etc/brainkeep/google.json".
EnvironmentFile=/etc/brainkeep/env
ExecStart=/opt/brainkeep/current/brainkeep --data-dir /var/lib/brainkeep/data serve --http-port 18765 --http-host ${BRAINKEEP_HOST} --auth-file /etc/brainkeep/auth.json --panel-auth-file /etc/brainkeep/panel.json $BRAINKEEP_ARGS
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# AF_INET6: OAuth login calls Google over HTTPS, which may resolve to IPv6.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
