[Unit]
Description=Consistent local backup of Brainkeep
After=brainkeep.service
Requires=brainkeep.service

[Service]
Type=oneshot
User=brainkeep
Group=brainkeep
UMask=0077
StateDirectory=brainkeep
StateDirectoryMode=0700
ExecStart=/opt/brainkeep/current/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
